# Environment files (real values never go into git)
.env
.env.local
.env.production
.env.*.local
!.env.example

# Local data volumes (may contain patient data)
volumes/*
!volumes/.gitkeep
volumes/mongodb/*
volumes/redis/*
volumes/minio/*
!volumes/mongodb/
!volumes/redis/
!volumes/minio/
!volumes/mongodb/.gitkeep
!volumes/redis/.gitkeep
!volumes/minio/.gitkeep

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Docker
.docker/

# Build artifacts
dist/
build/
*.zip
!visheart-deployment-*.zip

# Python / Node caches
__pycache__/
*.pyc
*.pyo
*.pyd
node_modules/

# Backup files
*.bak
*.backup

# Local docker-compose overrides (machine-specific image tags)
docker-compose.override.yml

# Environment secrets — never commit the real .env (the earlier rules above were
# malformed, e.g. ".env.env", so .env was tracked by mistake). Keep .env.example tracked.
.env
.env.*
!.env.example
