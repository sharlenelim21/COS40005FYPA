# Extends the pre-built GPU inference image with landmark model weights baked in.
# Teammates just pull this image — no .pth files needed on their machine.
#
# Build (run from repo root COS40005FYPA/):
#   docker build -f cardiac-component-segmentation-ai/visheart-local-deployment/Dockerfile.gpu \
#     -t sharlene21/visheart-gpu:1.4.1 \
#     -t sharlene21/visheart-gpu:latest \
#     .
#
# Push:
#   docker push sharlene21/visheart-gpu:1.4.1
#   docker push sharlene21/visheart-gpu:latest

FROM sveltes/visheart-inference-gpu:faithful-latest

# Copy landmark detection model weights.
# Source paths are relative to the build context (repo root COS40005FYPA/).
COPY UNETRESNET34/checkpoints/best_model_1ch.pth /app/UNETRESNET34/checkpoints/best_model_1ch.pth
COPY UNETRESNET34/checkpoints/best_model_2ch.pth /app/UNETRESNET34/checkpoints/best_model_2ch.pth
COPY UNETRESNET34/models/unet_resnet34.py /app/UNETRESNET34/models/unet_resnet34.py

# Copy inference model weights (UNet segmentation + 4D reconstruction).
# These may or may not be present in the base image — baking them in
# guarantees teammates don't need the local visheart-inference-gpu repo.
COPY cardiac-component-segmentation-ai/visheart-inference-gpu/app/models/unet.pth /app/app/models/unet.pth
COPY cardiac-component-segmentation-ai/visheart-inference-gpu/app/models/fourd_model_epoch_250.pth /app/app/models/fourd_model_epoch_250.pth

# Override deep_sdf files that had hardcoded .cuda() calls in the base image.
# The base image (sveltes/visheart-inference-gpu:faithful-latest) has active .cuda()
# calls in mesh.py (x4), utils.py (x3), and workspace.py (x2). Local versions use
# .to(device) so 4D reconstruction works on CPU too.
COPY cardiac-component-segmentation-ai/visheart-inference-gpu/app/dependencies/deep_sdf/mesh.py /app/app/dependencies/deep_sdf/mesh.py
COPY cardiac-component-segmentation-ai/visheart-inference-gpu/app/dependencies/deep_sdf/utils.py /app/app/dependencies/deep_sdf/utils.py
COPY cardiac-component-segmentation-ai/visheart-inference-gpu/app/dependencies/deep_sdf/workspace.py /app/app/dependencies/deep_sdf/workspace.py
