# .env.example - copy to .env and fill in real values. The real .env is gitignored.
# Placeholders (CHANGE_ME) mark secrets; other keys show example/default values.

APP_NAME=visheart
APP_VERSION=1.5.0
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=5000
GPU_PORT=8001
MONGODB_PORT=27017
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=CHANGE_ME
SESSION_NAME=visheart.sid
SESSION_MAX_AGE=86400000
MONGODB_URI=mongodb://<user>:<password>@mongodb:27017/visheart?authSource=admin&replicaSet=rs0
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=visheart
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=visheart-bucket
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_DEFAULT_BUCKETS=visheart-bucket
GPU_SERVER_URL=http://gpu:8001
GPU_API_KEY=CHANGE_ME
GPU_SERVER_AUTH_JWT_SECRET=CHANGE_ME
GPU_SERVER_PASSWORD=CHANGE_ME
INFERENCE_TIMEOUT=300
JWT_SECRET=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
BCRYPT_ROUNDS=10
TOKEN_EXPIRATION=1h
REFRESH_TOKEN_EXPIRATION=7d
LOG_LEVEL=info
LOG_DIR=./logs
CUDA_VISIBLE_DEVICES=0
USE_GPU=true
MAX_FILE_SIZE=524288000
MAX_UPLOAD_FILES=10
WORKER_THREADS=4
DEBUG=false
VERBOSE_LOGGING=false
