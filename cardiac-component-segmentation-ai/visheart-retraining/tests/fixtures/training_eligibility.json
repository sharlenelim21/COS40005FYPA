  "caseRules": [
    { "name": "a template project never trains", "isTemplate": true, "fromTemplate": true, "ai": "same_model", "heldOut": false, "expected": "template_project" },
    { "name": "a published template without its origin flag (before the backfill) still never trains", "isTemplate": true, "fromTemplate": false, "ai": "same_model", "heldOut": false, "expected": "template_project" },
    { "name": "an unpublished template with its own UNet result and edits never trains", "isTemplate": false, "fromTemplate": true, "ai": "same_model", "heldOut": false, "expected": "template_project" },
    { "name": "a template project stays in the held-out comparison", "isTemplate": true, "fromTemplate": true, "ai": "same_model", "heldOut": true, "expected": null },
    { "name": "an unpublished template stays in the held-out comparison too", "isTemplate": false, "fromTemplate": true, "ai": "same_model", "heldOut": true, "expected": null },
    { "name": "held out or not, a case needs its AI result", "isTemplate": true, "fromTemplate": true, "ai": "missing", "heldOut": true, "expected": "no_ai_result" },
    { "name": "a case without an AI result never trains", "isTemplate": false, "fromTemplate": false, "ai": "missing", "heldOut": false, "expected": "no_ai_result" },
    { "name": "the other model's AI result is not this case's", "isTemplate": false, "fromTemplate": false, "ai": "other_model", "heldOut": false, "expected": "no_ai_result" },
    { "name": "a saved, editable mask is not an AI result", "isTemplate": false, "fromTemplate": false, "ai": "not_ai_output", "heldOut": false, "expected": "no_ai_result" },
    { "name": "a corrected project with its own AI result trains", "isTemplate": false, "fromTemplate": false, "ai": "same_model", "heldOut": false, "expected": null }
  ],
  "sliceRules": [
    { "name": "a slice its AI result does not hold never trains, however large the edit",
      "slice": { "aiBaseline": false, "pixelsChanged": 500, "byClass": { "lvc": 500 } }, "expected": "no_ai_baseline" },
    { "name": "2% of the heart or more trains",
      "slice": { "aiBaseline": true, "editShare": 0.05, "structureChanged": false, "pixelsChanged": 3, "byClass": { "lvc": 3 } }, "expected": null },
    { "name": "under 2% does not",
      "slice": { "aiBaseline": true, "editShare": 0.01, "structureChanged": false, "pixelsChanged": 40, "byClass": { "lvc": 40 } }, "expected": "below_min_share" },
    { "name": "under 2%, but a structure was added, trains",
      "slice": { "aiBaseline": true, "editShare": 0.01, "structureChanged": true, "pixelsChanged": 2, "byClass": { "rv": 2 } }, "expected": null },
    { "name": "no heart on either side does not",
      "slice": { "aiBaseline": true, "editShare": null, "structureChanged": false, "pixelsChanged": 0, "byClass": {} }, "expected": "below_min_pixels" },
    { "name": "a slice nobody measured keeps the 20-pixel rule (the review queue's frameless masks)",
      "slice": { "pixelsChanged": 20, "byClass": { "lvc": 20 } }, "expected": null },
    { "name": "19 unmeasured pixels do not",
      "slice": { "pixelsChanged": 19, "byClass": { "lvc": 19 } }, "expected": "below_min_pixels" },
    { "name": "a slice with manual pixels never trains",
      "slice": { "aiBaseline": true, "editShare": 0.5, "structureChanged": false, "pixelsChanged": 30, "byClass": { "lvc": 27, "manual": 3 } }, "expected": "manual" }
