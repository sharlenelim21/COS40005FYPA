# Copy this file to smtp.release.env (git-ignored) and fill in the team's dedicated support Gmail account.
# Use a Gmail app password (Google Account > Security > App passwords), never the account's login password,
# and never a team member's personal mail. make-installer.ps1 copies these values into the installer.
VH_SUPPORT_EMAIL=visheart.support@example.com
VH_SMTP_USER=visheart.support@example.com
VH_SMTP_PASS=xxxx xxxx xxxx xxxx
